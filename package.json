{
    "name": "hakase",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "An RxJS-driven canvas sketchbook: scrub or loop a playhead through generative sketches.",
    "author": "Yunus Öztürk",
    "license": "ISC",
    "engines": {
        "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint . && npm run check:ui",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:dev": "docker compose up dev --build",
        "docker:build": "docker build --target export --output type=local,dest=dist .",
        "docker:preview": "docker compose --profile preview up preview --build",
        "check:ui": "node scripts/check-ui.mjs"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "lit-html": "^3.3.3",
        "prismjs": "^1.30.0",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@types/prismjs": "^1.26.6",
        "eslint": "^10.15.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
