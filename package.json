{
    "name": "hakase",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "An RxJS-driven canvas sketchbook: scrub or loop a playhead through generative sketches.",
    "author": "Yunus Öztürk",
    "license": "ISC",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:dev": "docker compose up dev --build",
        "docker:build": "docker build --target export --output type=local,dest=dist .",
        "docker:preview": "docker compose --profile preview up preview --build"
    },
    "dependencies": {
        "prismjs": "^1.30.0",
        "rxjs": "^7.8.2",
        "tweakpane": "^4.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tweakpane/core": "^2.0.5",
        "@types/node": "^22.20.1",
        "@types/prismjs": "^1.26.6",
        "eslint": "^10.9.1",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2"
    }
}
